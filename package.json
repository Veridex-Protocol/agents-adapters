{
  "name": "@veridex/agents-adapters",
  "version": "0.1.6",
  "description": "Framework adapters for the Veridex Agent Runtime — import/export agents from OpenAI Agents SDK, LangGraph, PydanticAI, and OpenAPI",
  "license": "MIT",
  "author": "Veridex Team",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@veridex/agents": "0.1.7"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@veridex/agents": "0.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "veridex",
    "agents",
    "adapters",
    "openai",
    "langgraph",
    "pydanticai",
    "openapi",
    "interop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veridex-Protocol/agents-adapters.git"
  },
  "homepage": "https://github.com/Veridex-Protocol/agents-adapters#readme",
  "bugs": {
    "url": "https://github.com/Veridex-Protocol/agents-adapters/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
